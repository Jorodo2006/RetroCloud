{
  "name": "retro-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "workspaces": [
    "api",
    "agent",
    "web",
    "packages/*"
  ],
  "scripts": {
    "env:init": "tsx scripts/init-env.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema db/schema.prisma --exit-code",
    "build": "npm run db:generate && tsc -b",
    "typecheck": "npm run db:generate && tsc -b && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:integration": "npm run build && tsx scripts/test-integration.ts",
    "check": "npm run db:validate && npm run typecheck && npm test",
    "dev": "npm run build && node --env-file=.env --import tsx --watch api/src/server.ts",
    "start": "node --env-file=.env api/dist/server.js",
    "storage:init": "node --env-file=.env --import tsx scripts/init-storage.ts",
    "test:integration:docker": "tsx scripts/test-integration.ts --docker",
    "test:unit:docker": "docker compose run --rm --no-deps -T api npm test -- --configLoader native --no-cache"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2",
    "mariadb": "3.5.4",
    "ip-address": "10.7.3"
  }
}
