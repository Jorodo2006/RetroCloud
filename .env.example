# Generado automáticamente con: npm run env:init
# .env está excluido de Git. Guarda sus credenciales junto a tus copias de seguridad.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL local, publicado solo en loopback.
MYSQL_DATABASE=retro_cloud
MYSQL_USER=retro_cloud
MYSQL_PASSWORD=__MYSQL_PASSWORD__
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__
MYSQL_PORT=3307
# URL para herramientas/API en Windows; Compose utiliza mysql:3306.
# Actualiza también esta URL si cambias las credenciales o el puerto (valores URL-encoded).
DATABASE_URL=mysql://retro_cloud:__MYSQL_PASSWORD__@127.0.0.1:3307/retro_cloud

# Ruta absoluta para ejecutar la API directamente en Windows.
# env:init la resuelve como <repositorio>/data/storage.
# Compose usa su propio volumen persistente local en /data/storage.
STORAGE_ROOT=__STORAGE_ROOT__

# No se necesita una cuenta cloud ni una clave de almacenamiento.
# Metadatos/RetroAchievements seran integraciones opcionales.

# Clave JWT de 32 bytes (64 caracteres hex); env:init la genera o la añade si falta.
# Cambiarla invalida los JWT emitidos; los refresh tokens mantienen su vigencia.
JWT_SECRET=__JWT_SECRET__
# first-user permite una sola alta; open abre el registro; closed lo desactiva.
REGISTRATION_MODE=first-user
# Origen del futuro portal, sin slash final. Solo se admiten peticiones web de este origen.
APP_ORIGIN=http://localhost:3000
# false solo para HTTP local. production exige true y APP_ORIGIN=https://...
COOKIE_SECURE=false


# Agente local (fase 3). La demo y el escaneo no necesitan credenciales.
# Para sincronizar, crea un dispositivo mediante la API y copia aqui su id y su clave.
AGENT_API_URL=http://localhost:3000
AGENT_DEVICE_ID=
AGENT_API_KEY=
# Carpetas absolutas en Windows; el agente solo lee los ROMs. No se crean automaticamente.
AGENT_ROMS_ROOT=__AGENT_ROMS_ROOT__
AGENT_STATE_ROOT=__AGENT_STATE_ROOT__
# JSON con subcarpetas relativas, slugs de consola y extensiones permitidas.
AGENT_LIBRARY_CONFIG=__AGENT_LIBRARY_CONFIG__
AGENT_SCAN_INTERVAL_SECONDS=300
AGENT_REQUEST_TIMEOUT_SECONDS=15
AGENT_MAX_FILES=100000
# Docker usa api:3000, /roms, /data/agent y /config/library.json internamente.
# El volumen agent-data y la carpeta AGENT_STATE_ROOT de Windows son estados separados.
