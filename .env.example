# Generado automáticamente con: npm run env:init
# Solo desarrollo local. .env está excluido de Git. No copies estas credenciales a Azure.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL 8.4 local; 3307 evita conflictos con instalaciones habituales en 3306.
MYSQL_DATABASE=retro_cloud
MYSQL_USER=retro_cloud
MYSQL_PASSWORD=__MYSQL_PASSWORD__
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__
MYSQL_PORT=3307
# URL para herramientas/API ejecutadas en Windows; Compose usa mysql:3306.
# Si cambias usuario/contraseña/puerto, actualiza también esta URL (credenciales URL-encoded).
DATABASE_URL=mysql://retro_cloud:__MYSQL_PASSWORD__@127.0.0.1:3307/retro_cloud

# Cuenta personalizada de Azurite. No es una cuenta real de Azure.
STORAGE_ACCOUNT_NAME=retrocloud
STORAGE_ACCOUNT_KEY=__STORAGE_ACCOUNT_KEY__
AZURITE_PORT=10000
# Compose sustituye el host por azurite:10000.
STORAGE_BLOB_ENDPOINT=http://127.0.0.1:10000/retrocloud
STORAGE_CONTAINER_SAVES=saves
STORAGE_CONTAINER_CAPTURES=captures

# JWT, RetroAchievements y proveedor de metadatos se añadirán en sus fases.
# No existe aún configuración de rutas ROM/save ni claves de usuario.
